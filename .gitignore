# Secrets — RTK and OpenAI credentials live here, never in the repo
.survey_keys
*.key

# Data the car produces (gigabytes; regenerate by driving)
data/
logs/
*.csv
!results/*.csv
# The recorded route is source, not data: without it the car has nothing
# to follow. It was silently dropped by the *.csv rule above.
!vehicle/donkey_path.csv

# Python
__pycache__/
*.pyc
.venv/
